# ─── Base de données PostgreSQL ───────────────────────────────────────────────
DATABASE_URL=postgresql://fintrack:fintrack@db:5432/fintrack
POSTGRES_USER=fintrack
POSTGRES_PASSWORD=fintrack
POSTGRES_DB=fintrack

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── JWT (RS256) ──────────────────────────────────────────────────────────────
# Générer avec : openssl genrsa -out private.pem 2048 && openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d

# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:3000
COOKIE_SECRET=change-me-in-production-32-chars-min

# ─── Email (Amazon SES) ───────────────────────────────────────────────────────
SES_REGION=eu-west-1
SES_FROM_EMAIL=noreply@fintrack.app
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Stockage fichiers — reçus (Amazon S3) ────────────────────────────────────
S3_BUCKET=fintrack-receipts
S3_REGION=eu-west-1

# ─── Taux de change ───────────────────────────────────────────────────────────
# Source à décider (PO-06) : Open Exchange Rates, Fixer.io, etc.
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=https://openexchangerates.org/api

# ─── 2FA (Twilio SMS, optionnel) ──────────────────────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ─── Open Banking (stub MVP — non connecté) ───────────────────────────────────
BANK_AGGREGATOR=tink
BANK_AGGREGATOR_API_KEY=
BANK_AGGREGATOR_SECRET=

# ─── Chiffrement des tokens bancaires (AES-256) ───────────────────────────────
TOKEN_ENCRYPTION_KEY=change-me-in-prod-exactly-32chars!
